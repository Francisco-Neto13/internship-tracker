# Test database from docker compose. Local-only credentials, safe to version.
# The db test setup refuses to run against a database whose name does not end in _test.
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/internship_tracker_test
DATABASE_AUTH_URL=postgres://auth_runtime:auth_runtime@localhost:5432/internship_tracker_test
DATABASE_MIGRATION_URL=postgres://migrator:migrator@localhost:5432/internship_tracker_test
BETTER_AUTH_SECRET=test-only-secret-not-used-anywhere-else-0123456789
BETTER_AUTH_URL=http://localhost:3000
