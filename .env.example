# Database: one connection string per role (RF003). Values below match docker compose.
# app_runtime: domain code, always subject to RLS (pooled connection on Neon)
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/internship_tracker
# auth_runtime: auth library only (pooled connection on Neon)
DATABASE_AUTH_URL=postgres://auth_runtime:auth_runtime@localhost:5432/internship_tracker
# migrator: owner of every object, used only by db:migrate and db:seed (direct connection on Neon)
DATABASE_MIGRATION_URL=postgres://migrator:migrator@localhost:5432/internship_tracker

# Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Storage (not wired yet)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Scheduled jobs (not wired yet)
CRON_SECRET=
