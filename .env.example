# Database: one connection string per role (RF003). Values below match docker compose.
# app_runtime: domain code, always subject to RLS
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/internship_tracker
# auth_runtime: auth library only
DATABASE_AUTH_URL=postgres://auth_runtime:auth_runtime@localhost:5432/internship_tracker
# migrator: owner of every object, used only by db:migrate and db:seed
DATABASE_MIGRATION_URL=postgres://migrator:migrator@localhost:5432/internship_tracker

# Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Client address for the sign-in rate limit (src/lib/auth-options.ts). Not needed on Vercel
# or in development. Self-hosted production: the header your proxy sets (e.g. x-real-ip)
# and the proxy addresses or CIDR ranges; without them the app refuses to start.
AUTH_IP_HEADERS=
AUTH_TRUSTED_PROXIES=
# Breached-password check against Have I Been Pwned (NIST SP 800-63B-4). "desligada" is
# accepted outside production only, e.g. offline development.
SENHAS_VAZADAS_VERIFICACAO=ativa
# Range endpoint of that check. Empty uses https://api.pwnedpasswords.com/range/; the e2e points
# it to the local stub (e2e/support/hibp-stub.mjs). Production accepts only HTTPS or loopback.
HIBP_RANGE_URL=

# Storage: private bucket, S3 API (D8, RNF-06). Values below match the SeaweedFS of docker compose;
# create the bucket once with `npm run storage:init`. Production (docker-compose.prod.yml):
# R2_ENDPOINT is the public HTTPS address of the storage, with generated keys. The R2_ prefix
# is historical: the project no longer uses Cloudflare R2.
R2_ENDPOINT=http://localhost:8333
R2_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=storage-local
R2_SECRET_ACCESS_KEY=storage-local-secret
R2_BUCKET=internship-tracker

# Daily routine (/api/cron/diaria, vercel.json): Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
# At least 32 characters (openssl rand -hex 32); empty refuses every call.
CRON_SECRET=
