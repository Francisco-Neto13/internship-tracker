# HTTPS and certificates are automatic. Caddy keeps the Host header, which the signature of
# the upload URLs covers.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# Overwrites what the client sent: the sign-in rate limit trusts this header (RF002)
		header_up X-Real-IP {remote_host}
	}
}

{$STORAGE_DOMAIN} {
	# Uploads go up to 10 MiB (D8); the server still checks size, type and hash on confirmation
	request_body {
		max_size 11MB
	}
	reverse_proxy storage:8333
}
